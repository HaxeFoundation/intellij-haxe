# hl-legacy32: emit the legacy (pre-native-i64) Int64 representation. The
# 32-bit HL VM refuses to LOAD a module using native 64-bit ints ("not
# supported by the HL32"); the legacy form loads and runs on both HL32 and
# HL64, so one adapter artifact serves both bitnesses. Pointer is Int64-based,
# so without this the adapter cannot debug on 32-bit HL at all.
-D hl-legacy32
-cp src/main/haxe
# version-pinned: resolves this exact version regardless of the machine's
# `haxelib set` selection (which stays untouched)
-lib format:3.7.0
-lib intellij-dap-protocol
-main ijhaxe.adapter.Main
-hl build/hl/hl-debug-adapter.hl
