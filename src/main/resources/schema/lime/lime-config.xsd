<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:intellij-haxe:lime-config"
           elementFormDefault="qualified" attributeFormDefault="unqualified">

    <xs:complexType name="section" mixed="true">
        <xs:annotation>
            <xs:documentation>Each attribute is stored as a config value of the section; nested elements store nested values.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:anyAttribute processContents="skip"/>
    </xs:complexType>

    <xs:element name="air" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Adobe AIR builds, such as <code>sdk-version</code>, <code>output-directory</code> and <code>profile</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="android" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Android builds, such as <code>target-sdk-version</code>, <code>minimum-sdk-version</code> and <code>permission</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="cpp" type="section">
        <xs:annotation>
            <xs:documentation>Settings for C++ builds, such as <code>buildLibrary</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="cs" type="section">
        <xs:annotation>
            <xs:documentation>Settings for C# builds, such as <code>buildLibrary</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="electron" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Electron builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="flash" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Flash builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="html5" type="section">
        <xs:annotation>
            <xs:documentation>Settings for HTML5 builds, such as <code>output-directory</code> and <code>dependency-path</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="ios" type="section">
        <xs:annotation>
            <xs:documentation>Settings for iOS builds, such as <code>deployment</code>, <code>device</code> and <code>linker-flags</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="linux" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Linux builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="mac" type="section">
        <xs:annotation>
            <xs:documentation>Settings for macOS builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="project" type="section">
        <xs:annotation>
            <xs:documentation>Settings for rebuilding the project's native code, such as <code>rebuild</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="tizen" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Tizen builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="tools" type="section">
        <xs:annotation>
            <xs:documentation>Settings for the Lime tools, such as <code>copy-ndlls</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="tvos" type="section">
        <xs:annotation>
            <xs:documentation>Settings for tvOS builds, such as <code>deployment</code> and <code>device</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="webassembly" type="section">
        <xs:annotation>
            <xs:documentation>Settings for WebAssembly builds, such as <code>output-directory</code> and <code>dependency-path</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="windows" type="section">
        <xs:annotation>
            <xs:documentation>Settings for Windows builds, such as <code>output-directory</code>.</xs:documentation>
        </xs:annotation>
    </xs:element>
</xs:schema>
