    <xs:attributeGroup name="conditional">
        <xs:attribute type="xs:string" name="if">
            <xs:annotation>
                <xs:documentation>Applies the element only when its condition holds.<p>A condition is a list of names. Names separated by a space must all hold, so <code>if="cpp debug"</code> means <code>cpp</code> and <code>debug</code>. Names separated by <code>||</code> are alternatives, so <code>if="android || ios"</code> means <code>android</code> or <code>ios</code>.</p><p>A name holds when it is a define set earlier in the file, an environment variable, the running command (such as <code>build</code>, <code>test</code> or <code>display</code>), or the word <code>true</code>. The word <code>false</code> never holds.</p><p>Lime defines these names for every build: the target (such as <code>html5</code>, <code>windows</code> or <code>android</code>), the target kind (<code>cpp</code>, <code>neko</code>, <code>hl</code>, <code>html5</code>, <code>flash</code> or <code>native</code>), the platform type (<code>desktop</code>, <code>mobile</code>, <code>web</code> or <code>console</code>), the build type (<code>debug</code>, <code>release</code> or <code>final</code>), and the name of each library added with <code>haxelib</code>.</p><p><code>${...}</code> values in the condition are replaced before it is checked.</p></xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute type="xs:string" name="unless">
            <xs:annotation>
                <xs:documentation>Skips the element when its condition holds. The condition is written as for <code>if</code>; for example, <code>unless="html5"</code> leaves the element out of HTML5 builds.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:complexType name="asset">
        <xs:annotation>
            <xs:documentation>Adds a file from the folder of the enclosing <code>assets</code> element. The element name sets the asset type: <code>image</code>, <code>sound</code>, <code>music</code>, <code>font</code> or <code>template</code>. The names <code>library</code> and <code>manifest</code> add a manifest.</xs:documentation>
        </xs:annotation>
        <xs:attribute name="path" type="string-min-len-1">
            <xs:annotation>
                <xs:documentation>The file, relative to the path of the enclosing <code>assets</code>.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="id" type="xs:string">
            <xs:annotation>
                <xs:documentation>The asset ID.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="string-min-len-1">
            <xs:annotation>
                <xs:documentation>The file, relative to the path of the enclosing <code>assets</code>. If <code>id</code> is missing, the name is also the asset ID. When both <code>name</code> and <code>path</code> are given, <code>name</code> is used.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="rename" type="xs:string">
            <xs:annotation>
                <xs:documentation>The path the asset gets in the application, instead of its path on disk.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="embed" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>Only the value <code>true</code> turns this on. Any other value counts as false, including <code>1</code> and <code>yes</code>.</xs:documentation>
            </xs:annotation>
        </xs:attribute>
