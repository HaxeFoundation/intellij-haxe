<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.intellij.plugins.haxe.v2.toolwindow.ui.HaxeCompileCommandDialog">
  <grid id="b1000" binding="panel" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="480" height="183"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="b1001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="b1002"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compile.command.dialog.file"/>
        </properties>
      </component>
      <component id="b1002" class="com.intellij.openapi.ui.ComboBox" binding="fileCombo">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="b1003" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="b1004"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compile.command.dialog.command"/>
        </properties>
      </component>
      <component id="b1004" class="com.intellij.openapi.ui.ComboBox" binding="commandCombo">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="b1005" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="b1006"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compile.command.dialog.arguments"/>
        </properties>
      </component>
      <component id="b1006" class="com.intellij.ui.components.JBTextField" binding="argumentsField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="b1007" class="javax.swing.JTextPane" binding="hintArea">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="9" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="48"/>
          </grid>
        </constraints>
        <properties>
          <editable value="false"/>
          <opaque value="false"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compile.command.dialog.hint"/>
        </properties>
      </component>
      <vspacer id="b1008">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
