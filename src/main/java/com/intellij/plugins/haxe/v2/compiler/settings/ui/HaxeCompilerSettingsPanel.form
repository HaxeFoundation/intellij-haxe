        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.tooltip"/>
        </properties>
      </component>
      <component id="c1015" class="javax.swing.JCheckBox" binding="diagnosticsErrorsCheckBox">
        <constraints>
          <grid row="11" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.errors.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.errors.tooltip"/>
        </properties>
      </component>
      <component id="c1016" class="javax.swing.JCheckBox" binding="diagnosticsUnusedImportsCheckBox">
        <constraints>
          <grid row="12" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.unused.imports.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.unused.imports.tooltip"/>
        </properties>
      </component>
      <component id="c1017" class="javax.swing.JCheckBox" binding="diagnosticsRemovableCodeCheckBox">
        <constraints>
          <grid row="13" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.removable.code.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.removable.code.tooltip"/>
        </properties>
      </component>
      <component id="c1018" class="javax.swing.JCheckBox" binding="diagnosticsOnlyCheckBox">
        <constraints>
          <grid row="14" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.only.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.diagnostics.only.tooltip"/>
        </properties>
      </component>
      <component id="c1019" class="javax.swing.JPanel" binding="tablePanel" custom-create="true">
        <constraints>
          <grid row="15" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
