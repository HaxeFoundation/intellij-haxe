<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.intellij.plugins.haxe.v2.compiler.settings.ui.HaxeCompilerSettingsPanel">
  <grid id="c1000" binding="mainPanel" layout-manager="GridLayoutManager" row-count="16" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="640" height="560"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c1001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="c1002"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.default.language.level"/>
        </properties>
      </component>
      <component id="c1002" class="com.intellij.openapi.ui.ComboBox" binding="defaultLevelCombo" custom-create="true">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
        </properties>
      </component>
      <component id="c1005" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="c1006"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.completion.mode"/>
        </properties>
      </component>
      <component id="c1006" class="com.intellij.openapi.ui.ComboBox" binding="completionModeCombo" custom-create="true">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.completion.mode.tooltip"/>
        </properties>
      </component>
      <component id="c1007" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="c1008"/>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.display.connection"/>
        </properties>
      </component>
      <component id="c1008" class="com.intellij.openapi.ui.ComboBox" binding="displayConnectionCombo" custom-create="true">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.display.connection.tooltip"/>
        </properties>
      </component>
      <component id="c1004" class="javax.swing.JCheckBox" binding="useLevelForConditionalsCheckBox">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.conditionals.language.level.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.conditionals.language.level.tooltip"/>
        </properties>
      </component>
      <component id="c1009" class="javax.swing.JCheckBox" binding="compilerIdeFeaturesCheckBox">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.tooltip"/>
        </properties>
      </component>
      <component id="c1010" class="javax.swing.JCheckBox" binding="featureInlaysCheckBox">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.inlays.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.inlays.tooltip"/>
        </properties>
      </component>
      <component id="c1011" class="javax.swing.JCheckBox" binding="featureFindUsagesCheckBox">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
