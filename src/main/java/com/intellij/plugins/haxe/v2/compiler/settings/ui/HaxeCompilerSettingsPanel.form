        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.find.usages.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.find.usages.tooltip"/>
        </properties>
      </component>
      <component id="c1012" class="javax.swing.JCheckBox" binding="featureNavigationCheckBox">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.navigation.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.navigation.tooltip"/>
        </properties>
      </component>
      <component id="c1020" class="javax.swing.JCheckBox" binding="featureGeneratedMemberPreviewCheckBox">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="4" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.navigation.preview.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.navigation.preview.tooltip"/>
        </properties>
      </component>
      <component id="c1013" class="javax.swing.JCheckBox" binding="featureCompletionCheckBox">
        <constraints>
          <grid row="9" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.completion.checkbox"/>
          <toolTipText resource-bundle="messages/HaxeBundle" key="haxe.compiler.ide.features.completion.tooltip"/>
        </properties>
      </component>
      <component id="c1014" class="javax.swing.JCheckBox" binding="compilerDiagnosticsCheckBox">
        <constraints>
