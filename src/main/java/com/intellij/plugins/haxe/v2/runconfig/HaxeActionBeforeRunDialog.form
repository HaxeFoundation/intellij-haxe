<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.intellij.plugins.haxe.v2.runconfig.HaxeActionBeforeRunDialog">
  <grid id="a1000" binding="panel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="520" height="200"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a1001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="a1002"/>
          <text resource-bundle="messages/HaxeDebuggerBundle" key="haxe.before.run.dialog.build.file"/>
        </properties>
      </component>
      <component id="a1002" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="fileField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="a1003" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="a1004"/>
          <text resource-bundle="messages/HaxeDebuggerBundle" key="haxe.before.run.dialog.action"/>
        </properties>
      </component>
      <component id="a1004" class="com.intellij.openapi.ui.ComboBox" binding="actionCombo">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="a1005" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="a1006"/>
          <text resource-bundle="messages/HaxeDebuggerBundle" key="haxe.before.run.dialog.arguments"/>
        </properties>
      </component>
      <component id="a1006" class="com.intellij.ui.components.JBTextField" binding="argumentsField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="a1007" class="com.intellij.ui.components.JBCheckBox" binding="injectDebugCheckBox">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeDebuggerBundle" key="haxe.before.run.dialog.inject.debug"/>
        </properties>
      </component>
      <component id="a1008" class="com.intellij.ui.components.JBLabel" binding="injectDebugPreview" custom-create="true">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="a1009" class="com.intellij.ui.components.JBLabel" binding="derivedNote" custom-create="true">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <vspacer id="a1010">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
