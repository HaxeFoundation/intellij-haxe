<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1"
      bind-to-class="com.intellij.plugins.haxe.profiler.bridge.hashlink.HaxeHlProfilerConfigurable">
  <grid id="27dc6" binding="panel" layout-manager="GridLayoutManager" row-count="2" column-count="2"
        same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="400" height="80"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a1001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0"
                indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="a1002"/>
          <text resource-bundle="messages/HaxeProfilerBundle" key="haxe.profiler.samples.label"/>
        </properties>
      </component>
      <component id="a1002" class="com.intellij.ui.components.JBTextField" binding="samplesField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1"
                indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>

      <vspacer id="a1003">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2"
                indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
