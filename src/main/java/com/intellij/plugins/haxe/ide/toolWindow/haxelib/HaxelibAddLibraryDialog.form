<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.intellij.plugins.haxe.ide.toolWindow.haxelib.HaxelibAddLibraryDialog">
  <grid id="h1000" binding="panel" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="480" height="160"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="h1001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="h1002"/>
          <text resource-bundle="messages/HaxeBundle" key="haxelib.explorer.add.dialog.name"/>
        </properties>
      </component>
      <component id="h1002" class="com.intellij.ui.components.JBTextField" binding="nameField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="h1003" class="com.intellij.ui.components.JBRadioButton" binding="devRadio">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxelib.explorer.add.dialog.dev"/>
        </properties>
      </component>
      <component id="h1004" class="com.intellij.openapi.ui.TextFieldWithBrowseButton" binding="devDirectoryField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="h1005" class="com.intellij.ui.components.JBRadioButton" binding="gitRadio">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="messages/HaxeBundle" key="haxelib.explorer.add.dialog.git"/>
        </properties>
      </component>
      <component id="h1006" class="com.intellij.ui.components.JBTextField" binding="gitUrlField">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="h1007" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <labelFor value="h1008"/>
          <text resource-bundle="messages/HaxeBundle" key="haxelib.explorer.git.dialog.ref"/>
        </properties>
      </component>
      <component id="h1008" class="com.intellij.ui.components.JBTextField" binding="gitRefField">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <vspacer id="h1009">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
